#!/usr/bin/env python3
"""ksctl — kernel-set model->kernel planning CLI.

Pure stdlib (argparse + json). Reads models/registry.json and uses the
selection engine in select.py to pick the strongest kernel-set entry point per
logical op for a given (model, gpu, dtype, mode).

Subcommands:
  ksctl list                                  list known models / families
  ksctl info   --model M                      show architecture facts + op map
  ksctl plan   --model M --gpu G --dtype D [--mode inference|training] [--json]
  ksctl table  [--gpu G] [--dtype D] [--mode] [--md FILE]   model->kernel table
  ksctl backends [--gpu G] [--dtype D] [--json]  best-available backend per op
  ksctl optimal  [--sm N] [--dtype D] [--op O] [--json]  Cartesian optimal table

Examples:
  ksctl list
  ksctl plan --model deepseek-v3 --gpu h100 --dtype fp8
  ksctl plan --model llama-3-8b --gpu a100 --dtype bf16 --json
  ksctl table --gpu h100 --md docs/MODEL_KERNEL_MAP.md
  ksctl backends --gpu h100 --dtype fp8
  ksctl backends                              # probe this host
  ksctl optimal --sm 89                       # promoted measured + heuristic
  ksctl optimal --op rmsnorm                  # one op across all SMs/dtypes
"""

import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

import select as sel  # noqa: E402  (local module)

# The best-available-backend dispatcher (kernel_set.dispatch) is pure stdlib and
# import-safe with no torch / CUDA / shared library, so importing it keeps ksctl
# dependency-free. It lives in the Python binding tree; add that to the path.
_REPO_ROOT = os.path.dirname(HERE)
_BINDINGS_PY = os.path.join(_REPO_ROOT, "bindings", "python")
if os.path.isdir(os.path.join(_BINDINGS_PY, "kernel_set")):
    sys.path.insert(0, _BINDINGS_PY)
try:  # optional: `ksctl backends` is the only command that needs it
    from kernel_set import dispatch as _dispatch  # noqa: E402
except Exception:  # pragma: no cover - binding tree absent
    _dispatch = None


# ---------------------------------------------------------------------------
# Pretty helpers
# ---------------------------------------------------------------------------
def _hr(c="-", n=78):
    return c * n


def cmd_list(args):
    reg = sel.load_registry()
    fams = [m for m in reg["models"] if m["kind"] == "family"]
    mods = [m for m in reg["models"] if m["kind"] == "model"]
    if args.json:
        print(json.dumps({
            "families": [{"id": m["id"], "family": m["family"],
                          "examples": m["examples"]} for m in fams],
            "models": [{"id": m["id"], "family": m["family"]} for m in mods],
        }, indent=2))
        return 0
    # One registry entry per line keeps `ksctl list | wc -l` equal to the live
    # registry size. Use `--json` for structured family/model grouping.
    for m in reg["models"]:
        print(f"{m['id']:28s} {m['kind']:6s} {m['family']}")
    return 0


def cmd_info(args):
    reg = sel.load_registry()
    try:
        m = sel.find_model(reg, args.model)
    except sel.SelectionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(m, indent=2))
        return 0
    a = m["arch"]
    print(_hr("="))
    print(f"{m['id']}   [{m['kind']}]   family: {m['family']}")
    print(_hr("="))
    print(m["notes"])
    if m["examples"]:
        print(f"examples: {', '.join(m['examples'])}")
    print()
    s = sel.arch_summary(a)
    print("ARCHITECTURE")
    print(f"  attention   : {s['attention']}  "
          f"(heads={s['heads']} kv_heads={s['kv_heads']} head_dim={s['head_dim']})")
    print(f"  hidden      : {s['hidden']}")
    print(f"  vocab       : {s['vocab']}")
    print(f"  norm        : {s['norm']}  ({a.get('norm_positions','pre')})")
    print(f"  rope        : {s['rope']}")
    print(f"  mlp         : {s['mlp']}  (inter={a['mlp'].get('inter')})")
    print(f"  quant       : {s['quant']}")
    if a.get("extras"):
        print(f"  extras      : {', '.join(a['extras'])}")
    print()
    print("DEFAULT OP -> KERNEL MAP (pre-selection)")
    for op in reg["logical_ops"]:
        spec = m["ops"].get(op)
        desc = reg["op_descriptions"].get(op, "")
        if spec is None:
            print(f"  {op:18s} {'-':28s} ({desc})")
        else:
            print(f"  {op:18s} {spec['fn']:28s} ({desc})")
    return 0


def _print_plan(plan):
    s = plan["arch_summary"]
    print(_hr("="))
    print(f"PLAN  {plan['model']}  ({plan['family']})")
    print(f"  GPU            : {plan['gpu']}  (sm{plan['sm']})")
    print(f"  requested dtype: {plan['requested_dtype']}")
    print(f"  resolved scheme: {plan['resolved_scheme']}"
          + (f"   [{plan['dtype_note']}]" if plan["dtype_note"] else ""))
    print(f"  mode           : {plan['mode']}")
    print(f"  arch           : {s['attention']} | norm={s['norm']} | "
          f"mlp={s['mlp']} | rope={s['rope']}")
    print(_hr("="))
    print(f"  {'OP':18s} {'KERNEL-SET FN':30s} {'KS_DTYPE':16s} RATIONALE")
    print(f"  {_hr('-', 16):18s} {_hr('-', 28):30s} {_hr('-', 14):16s} "
          f"{_hr('-', 8)}")
    for op, e in plan["ops"].items():
        print(f"  {op:18s} {e['fn']:30s} {e['ks_dtype']:16s} {e['rationale']}")
    return 0


def cmd_plan(args):
    reg = sel.load_registry()
    try:
        plan = sel.select(args.model, args.gpu, args.dtype, args.mode, reg)
    except sel.SelectionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(plan, indent=2))
        return 0
    return _print_plan(plan)


# ---------------------------------------------------------------------------
# table: rows = models, columns = logical ops -> chosen fn(+dtype)
# ---------------------------------------------------------------------------
TABLE_OPS = [
    ("embedding", "embed"),
    ("attn_norm", "attn_norm"),
    ("rope", "rope"),
    ("attn_prefill", "prefill"),
    ("attn_decode", "decode"),
    ("qkv_proj", "qkv"),
    ("o_proj", "o_proj"),
    ("ffn_norm", "ffn_norm"),
    ("mlp_gate_up", "gate_up"),
    ("mlp_act", "act"),
    ("mlp_down", "down"),
    ("moe_gate", "moe_gate"),
    ("moe_grouped_gemm", "moe_gemm"),
    ("lm_head", "lm_head"),
    ("sampling", "sample"),
]


def _short_dt(ks_dtype):
    return {
        "KS_DTYPE_BF16": "bf16", "KS_DTYPE_F16": "fp16", "KS_DTYPE_F32": "f32",
        "KS_DTYPE_F8E4M3": "fp8", "KS_DTYPE_F8E5M2": "fp8e5", "KS_DTYPE_I8": "i8",
    }.get(ks_dtype, ks_dtype)


def _cell(plan, op):
    e = plan["ops"].get(op)
    if e is None:
        return "—"
    return f"{e['fn']}<br>`{_short_dt(e['ks_dtype'])}`"


def build_table_md(gpu, dtype, mode):
    reg = sel.load_registry()
    gkey, gcaps = sel.resolve_gpu(gpu)
    lines = []
    lines.append(f"# kernel-set Model -> Kernel Map")
    lines.append("")
    lines.append(f"Auto-generated by `ksctl table`. "
                 f"Each cell is the strongest kernel-set C ABI entry point the "
                 f"selection engine picks for that (model, op), with the compute "
                 f"dtype handed to the kernel.")
    lines.append("")
    lines.append(f"- **GPU**: {gcaps['name']} (sm{gcaps['sm']}, {gcaps['arch']}; "
                 f"fp8={'yes' if gcaps['fp8'] else 'no'}, "
                 f"bf16={'yes' if gcaps['bf16'] else 'no'}, "
                 f"tf32={'yes' if gcaps['tf32'] else 'no'})")
    lines.append(f"- **Requested dtype**: `{dtype}`  ·  **Mode**: `{mode}`")
    lines.append(f"- **ABI header**: `{reg['abi_header']}`")
    lines.append("")
    lines.append("Regenerate with:")
    lines.append("")
    lines.append("```")
    lines.append(f"python3 models/ksctl table --gpu {gpu} --dtype {dtype} "
                 f"--mode {mode} --md docs/MODEL_KERNEL_MAP.md")
    lines.append("```")
    lines.append("")

    # --- summary table: arch + chosen quant scheme -------------------------
    lines.append("## Architecture & dtype summary")
    lines.append("")
    hdr = ["model", "attention", "heads/kv", "head_dim", "norm", "rope",
           "mlp", "scheme"]
    lines.append("| " + " | ".join(hdr) + " |")
    lines.append("|" + "|".join(["---"] * len(hdr)) + "|")
    for m in reg["models"]:
        plan = sel.select(m["id"], gpu, dtype, mode, reg)
        s = plan["arch_summary"]
        row = [
            f"`{m['id']}`", s["attention"],
            f"{s['heads']}/{s['kv_heads']}", str(s["head_dim"]),
            s["norm"], s["rope"], s["mlp"],
            f"`{plan['resolved_scheme']}`",
        ]
        lines.append("| " + " | ".join(row) + " |")
    lines.append("")

    # --- the big op-by-op table (split for readability) --------------------
    op_groups = [
        ("Attention path", ["embedding", "attn_norm", "rope",
                            "attn_prefill", "attn_decode", "qkv_proj", "o_proj"]),
        ("MLP / MoE path", ["ffn_norm", "mlp_gate_up", "mlp_act", "mlp_down",
                            "moe_gate", "moe_grouped_gemm", "lm_head", "sampling"]),
    ]
    label = {k: v for k, v in TABLE_OPS}
    for title, group in op_groups:
        lines.append(f"## {title}")
        lines.append("")
        hdr = ["model"] + [label.get(op, op) for op in group]
        lines.append("| " + " | ".join(hdr) + " |")
        lines.append("|" + "|".join(["---"] * len(hdr)) + "|")
        for m in reg["models"]:
            plan = sel.select(m["id"], gpu, dtype, mode, reg)
            row = [f"`{m['id']}`"] + [_cell(plan, op) for op in group]
            lines.append("| " + " | ".join(row) + " |")
        lines.append("")

    # --- legend ------------------------------------------------------------
    lines.append("## Op legend")
    lines.append("")
    lines.append("| column | logical op |")
    lines.append("|---|---|")
    for op, short in TABLE_OPS:
        lines.append(f"| `{short}` | {reg['op_descriptions'].get(op, op)} |")
    lines.append("")
    return "\n".join(lines) + "\n"


def cmd_table(args):
    md = build_table_md(args.gpu, args.dtype, args.mode)
    if args.md:
        with open(args.md, "w") as f:
            f.write(md)
        print(f"wrote {args.md} ({md.count(chr(10))} lines)")
        return 0
    sys.stdout.write(md)
    return 0


# ---------------------------------------------------------------------------
# backends: per logical op, the rank-ordered provider chain + which one WOULD
# be selected for a given (gpu, dtype). Uses kernel_set.dispatch's curated
# registry + availability probe. On a no-GPU host it prints the chain and
# selects 'kernel-set (fallback)'.
# ---------------------------------------------------------------------------
def cmd_backends(args):
    if _dispatch is None:
        print("error: kernel_set.dispatch not importable (Python binding tree "
              "not found next to this CLI).", file=sys.stderr)
        return 2

    gpu = args.gpu          # None => probe this host
    dtype = args.dtype      # None => no dtype gate
    sm = _dispatch.resolve_sm(gpu)

    if args.json:
        out = {
            "gpu": gpu or "auto",
            "sm": sm,
            "dtype": dtype or "any",
            "ops": {},
        }
        for op in _dispatch.ops():
            chosen = _dispatch.which(op, gpu=gpu, dtype=dtype)
            out["ops"][op] = {
                "selected": chosen,
                "chain": _dispatch.chain(op, gpu=gpu, dtype=dtype),
            }
        print(json.dumps(out, indent=2))
        return 0

    where = (f"gpu={gpu} (sm{sm})" if gpu else
             (f"this host (sm{sm})" if sm is not None
              else "this host (no CUDA GPU detected)"))
    print(_hr("="))
    print(f"BEST-AVAILABLE BACKEND PER OP   {where}   dtype={dtype or 'any'}")
    print(_hr("="))
    print("Each op lists its rank-ordered provider chain; [*] marks installed &")
    print("arch/dtype-compatible providers; -> marks the one that WOULD be used.")
    print("The kernel-set C ABI is the always-available portable fallback.")
    print(_hr("-"))
    for op in _dispatch.ops():
        chosen = _dispatch.which(op, gpu=gpu, dtype=dtype)
        rows = _dispatch.chain(op, gpu=gpu, dtype=dtype)
        print(f"\n{op}")
        for r in rows:
            mark = "->" if r["name"] == chosen else "  "
            avail = "[*]" if r["selectable"] else "[ ]"
            gate = f"sm{r['min_sm']}+" if r["min_sm"] else "any"
            name = r["name"]
            if r["is_kernel_set"]:
                name = f"{name} (fallback)"
            note = f"  {r['note']}" if r["note"] else ""
            print(f"  {mark} {avail} rank{r['rank']:<2} {name:<22} "
                  f"[{gate:<6} {r['dtypes'] or 'any'}]{note}")
    print(_hr("-"))
    print("Legend: [*] selectable here · [ ] gated out (not installed / arch / "
          "dtype) · -> chosen.")
    return 0


# ---------------------------------------------------------------------------
# optimal: the SM x dtype x op Cartesian optimal-selection table (rows =
# logical_op, sections = sm, cell = provider with [M]=measured / [h]=heuristic).
# Reads providers/optimal.json (generated by scripts/gen_optimal.py). Pure
# stdlib (json) — no kernel_set import needed.
# ---------------------------------------------------------------------------
_OPTIMAL_PATH = os.path.join(_REPO_ROOT, "providers", "optimal.json")


def _load_optimal():
    with open(_OPTIMAL_PATH) as f:
        return json.load(f)


def cmd_optimal(args):
    try:
        doc = _load_optimal()
    except FileNotFoundError:
        print("error: providers/optimal.json not found — run "
              "`python3 scripts/gen_optimal.py` first.", file=sys.stderr)
        return 2

    cells = doc["cells"]

    # Optional filters.
    def _norm_op(o):
        aliases = {
            "attention.prefill": "attention_prefill",
            "attention.decode": "attention_decode",
            "norm.rmsnorm": "rmsnorm",
            "norm.fused_add_rmsnorm": "fused_add_rmsnorm",
            "rope.apply": "rope", "act.swiglu": "swiglu",
            "gemm.dense": "gemm", "loss.cross_entropy": "cross_entropy",
        }
        return aliases.get(o, o)

    want_sm = int(args.sm) if args.sm is not None else None
    want_dtype = args.dtype
    want_op = _norm_op(args.op) if args.op else None

    rows = [c for c in cells
            if (want_sm is None or c["sm"] == want_sm)
            and (want_dtype is None or c["dtype"] == want_dtype)
            and (want_op is None or c["logical_op"] == want_op)]

    if args.json:
        print(json.dumps({
            "filter": {"sm": want_sm, "dtype": want_dtype, "op": want_op},
            "stats": doc.get("stats", {}),
            "fill_rule": doc.get("fill_rule", ""),
            "cells": rows,
        }, indent=2))
        return 0

    if not rows:
        print("(no cells match the given filters)")
        return 0

    # Build a grid: rows = (logical_op, dtype); columns = sm (sections).
    sms = sorted({c["sm"] for c in rows})
    ops = sorted({c["logical_op"] for c in rows})
    dtypes_by_op = {}
    for c in rows:
        dtypes_by_op.setdefault(c["logical_op"], set()).add(c["dtype"])

    by_key = {(c["logical_op"], c["sm"], c["dtype"]): c for c in rows}

    def _mark(c):
        src = c["source"]
        tag = "[M]" if src == "measured" else "[h]"
        return f"{c['provider']}{tag}"

    stats = doc.get("stats", {})
    print(_hr("="))
    print("OPTIMAL KERNEL SELECTION — SM x dtype x op Cartesian table")
    print(f"  {stats.get('total', len(cells))} cells total · "
          f"{stats.get('measured', 0)} promoted measured [M] · "
          f"{stats.get('heuristic', 0)} heuristic [h] · "
          f"{stats.get('observed_not_promoted', 0)} observed-not-promoted")
    flt = []
    if want_op:
        flt.append(f"op={want_op}")
    if want_sm is not None:
        flt.append(f"sm={want_sm}")
    if want_dtype:
        flt.append(f"dtype={want_dtype}")
    if flt:
        print(f"  filter: {', '.join(flt)}")
    print(_hr("="))
    print("[M] = promoted measured benchmark winner (overrides) · [h] = "
          "heuristic baseline (fill).")
    print("Non-promoted diagnostics stay in benchmark results and do not "
          "change this table. Every cell's")
    print("fallback chain terminates in kernel-set.")
    print(_hr("-"))

    col_w = 22
    # Header row of SM sections.
    hdr = f"  {'op':18s} {'dtype':6s} " + "".join(
        f"sm{sm:<{col_w - 2}d}" for sm in sms)
    print(hdr)
    print(f"  {_hr('-', 16):18s} {_hr('-', 5):6s} " + "".join(
        _hr('-', col_w - 1) + " " for _ in sms))
    for op in ops:
        dtypes = sorted(dtypes_by_op.get(op, []))
        for dt in dtypes:
            cells_row = []
            any_cell = False
            for sm in sms:
                c = by_key.get((op, sm, dt))
                if c is None:
                    cells_row.append(f"{'—':<{col_w}s}")
                else:
                    any_cell = True
                    cells_row.append(f"{_mark(c):<{col_w}s}")
            if any_cell:
                print(f"  {op:18s} {dt:6s} " + "".join(cells_row))
    print(_hr("-"))
    print("Regenerate: python3 scripts/gen_optimal.py   ·   "
          "inspect host dispatch: python3 models/ksctl backends")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="ksctl",
        description="kernel-set model->kernel planning CLI")
    sub = p.add_subparsers(dest="cmd")

    p_list = sub.add_parser("list", help="list known models / families")
    p_list.add_argument("--json", action="store_true")
    p_list.set_defaults(func=cmd_list)

    p_info = sub.add_parser("info", help="show architecture facts + op map")
    p_info.add_argument("--model", required=True)
    p_info.add_argument("--json", action="store_true")
    p_info.set_defaults(func=cmd_info)

    p_plan = sub.add_parser("plan", help="auto-select strongest kernel per op")
    p_plan.add_argument("--model", required=True)
    p_plan.add_argument("--gpu", required=True)
    p_plan.add_argument("--dtype", default="auto")
    p_plan.add_argument("--mode", default="inference",
                        choices=["inference", "training"])
    p_plan.add_argument("--json", action="store_true")
    p_plan.set_defaults(func=cmd_plan)

    p_tab = sub.add_parser("table", help="emit model->kernel markdown table")
    p_tab.add_argument("--gpu", default="h100")
    p_tab.add_argument("--dtype", default="auto")
    p_tab.add_argument("--mode", default="inference",
                       choices=["inference", "training"])
    p_tab.add_argument("--md", help="write to this file instead of stdout")
    p_tab.set_defaults(func=cmd_table)

    p_be = sub.add_parser(
        "backends",
        help="best-available industry backend per op (probes this host)")
    p_be.add_argument("--gpu", default=None,
                      help="target GPU (h100, l4, a100, ... or smXX); "
                           "default: auto-detect this host")
    p_be.add_argument("--dtype", default=None,
                      help="gate by dtype (fp16/bf16/fp8/int8/int4); "
                           "default: no dtype gate")
    p_be.add_argument("--json", action="store_true")
    p_be.set_defaults(func=cmd_backends)

    p_opt = sub.add_parser(
        "optimal",
        help="print the SM x dtype x op Cartesian optimal-selection table")
    p_opt.add_argument("--sm", type=int, default=None,
                       help="filter to one SM (e.g. 89, 90, 100)")
    p_opt.add_argument("--dtype", default=None,
                       help="filter to one dtype (fp16/bf16/fp32/fp8/int8/int4)")
    p_opt.add_argument("--op", default=None,
                       help="filter to one logical op (e.g. rmsnorm, "
                            "attention_prefill, or dotted norm.rmsnorm)")
    p_opt.add_argument("--json", action="store_true")
    p_opt.set_defaults(func=cmd_optimal)

    args = p.parse_args(argv)
    if not getattr(args, "cmd", None):
        p.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
